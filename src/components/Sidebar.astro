---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { ext } from '../lib/links';
import { getProfile, getSections } from '../lib/content';

const profile = await getProfile();
const sections = await getSections();
---
<aside class="side">
  <div class="side-inner">
    <div class="bp" data-label="#profile">
      <figure class="portrait">
        <Image src={profile.portrait} alt={`Portrait of ${profile.name}`} width={202} height={202} loading="eager" />
        <span class="tick tl"></span><span class="tick tr"></span><span class="tick bl"></span><span class="tick br"></span>
      </figure>
      <h1 class="name">{profile.name}</h1>
      <p class="role">
        {profile.title}<br />
        {profile.affiliation.url ? <a href={profile.affiliation.url} {...ext(profile.affiliation.url)}>{profile.affiliation.name}</a> : profile.affiliation.name}
      </p>
      <ul class="links">
        {
          profile.links.map((l) => (
            <li>
              <a href={l.url} {...ext(l.url)}>
                <Icon name={l.icon} />
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="toc bp" aria-label="Sections" data-label="#contents">
      <ol>
        {
          sections.map(({ entry, anchor }, i) => (
            <li>
              <a href={`#${anchor}`} data-toc={anchor}>
                <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                {entry.data.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="controls">
      <button class="mono ctrl" id="theme-toggle" type="button" aria-label="Color theme">
        <span data-icon="auto"><Icon name="auto" size={14} /></span>
        <span data-icon="light"><Icon name="sun" size={14} /></span>
        <span data-icon="dark"><Icon name="moon" size={14} /></span>
        <span class="label">Auto</span>
      </button>
      <button class="mono ctrl" id="blueprint-toggle" type="button" aria-pressed="false" title="Show the page blueprint">
        <Icon name="blueprint" size={14} />
        Blueprint
      </button>
    </div>
  </div>
</aside>

<style>
  .side {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    height: 100dvh;
  }
  .side-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 88px 0 36px;
  }
  .portrait {
    position: relative;
    width: 112px;
    margin: 0 0 28px 8px;
  }
  .portrait :global(img) {
    width: 112px;
    height: 112px;
    border-radius: 6px;
    object-fit: cover;
  }
  .tick {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--gold);
    border-style: solid;
    border-width: 0;
  }
  .tl { top: -7px; left: -7px; border-top-width: 2px; border-left-width: 2px; }
  .tr { top: -7px; right: -7px; border-top-width: 2px; border-right-width: 2px; }
  .bl { bottom: -7px; left: -7px; border-bottom-width: 2px; border-left-width: 2px; }
  .br { bottom: -7px; right: -7px; border-bottom-width: 2px; border-right-width: 2px; }
  .name {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 50px;
    line-height: 0.95;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .role {
    margin: 14px 0 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted);
  }
  .role a {
    color: var(--ink-2);
  }
  .links {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    color: var(--ink-2);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }
  .toc {
    margin-top: 52px;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 4px 0 4px 16px;
    font-size: 14.5px;
    color: var(--muted);
    text-decoration: none;
  }
  .toc a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 6px;
    height: 1px;
    background: currentColor;
    transition: width 0.2s;
  }
  .toc a .mono {
    font-size: 11px;
    opacity: 0.7;
  }
  .toc a:hover {
    color: var(--ink);
  }
  .toc a.active {
    color: var(--ink);
  }
  .toc a.active::before {
    width: 10px;
    background: var(--accent);
  }
  .controls {
    margin-top: auto;
    display: flex;
    gap: 8px;
  }
  .ctrl {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .ctrl:hover {
    color: var(--ink);
    border-color: var(--muted);
  }
  #blueprint-toggle[aria-pressed='true'] {
    color: var(--bp-ink);
    background: var(--bp);
    border-color: var(--bp);
  }
  #theme-toggle [data-icon] {
    display: none;
  }
  :global(:root:not([data-theme])) #theme-toggle [data-icon='auto'],
  :global(:root[data-theme='light']) #theme-toggle [data-icon='light'],
  :global(:root[data-theme='dark']) #theme-toggle [data-icon='dark'] {
    display: inline-flex;
  }

  @media (max-width: 960px) {
    .side {
      position: static;
      height: auto;
    }
    .side-inner {
      padding: 48px 0 0;
    }
    .name {
      font-size: 44px;
    }
    .toc {
      display: none;
    }
    .controls {
      margin-top: 24px;
    }
  }
  @media (max-height: 700px) and (min-width: 961px) {
    .side-inner {
      padding-top: 56px;
    }
    .toc {
      margin-top: 32px;
    }
  }
</style>
