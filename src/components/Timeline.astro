---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { ext } from '../lib/links';

interface Props {
  items: CollectionEntry<'sections'>['data']['items'];
}
const { items } = Astro.props;
---
<ul class="timeline">
  {
    items.map((item) => (
      <li>
        <span class="logo">
          {item.logo && <Image src={item.logo} alt="" width={72} height={72} />}
        </span>
        <div class="body">
          <span class="name">{item.url ? <a href={item.url} {...ext(item.url)}>{item.name}</a> : item.name}</span>
          {item.role && <span class="role">{item.role}</span>}
        </div>
        {item.date && <span class="mono date">{item.date}</span>}
      </li>
    ))
  }
</ul>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    column-gap: 18px;
    align-items: start;
    padding: 16px 0;
  }
  li + li {
    border-top: 1px solid var(--rule);
  }
  .logo {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 1px var(--rule);
  }
  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .name {
    color: var(--ink);
    font-weight: 550;
    line-height: 1.4;
  }
  .role {
    font-size: 14.5px;
    color: var(--muted);
  }
  .date {
    color: var(--muted);
    white-space: nowrap;
    padding-top: 3px;
  }
  @media (max-width: 600px) {
    li {
      grid-template-columns: 32px minmax(0, 1fr);
      column-gap: 14px;
    }
    .logo {
      width: 32px;
      height: 32px;
    }
    .date {
      grid-column: 2;
      padding-top: 6px;
    }
  }
</style>
