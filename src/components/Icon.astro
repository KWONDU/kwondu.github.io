---
interface Props {
  name: 'mail' | 'scholar' | 'github' | 'linkedin' | 'x' | 'cv' | 'link' | 'award' | 'star' | 'arrow' | 'sun' | 'moon' | 'auto' | 'blueprint';
  size?: number;
}
const { name, size = 16 } = Astro.props;
---
<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6 8.5-6" /></>)}
  {name === 'scholar' && (<><path d="M2 9.5 12 4l10 5.5-10 5.5z" /><path d="M6 11.7V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.3" /><path d="M22 9.5V15" /></>)}
  {name === 'github' && (
    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
  )}
  {name === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" /></>)}
  {name === 'x' && (<><path d="M4 4l16 16M20 4 4 20" /></>)}
  {name === 'cv' && (<><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></>)}
  {name === 'link' && (<><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></>)}
  {name === 'award' && (<><circle cx="12" cy="9" r="6" /><path d="M8.5 13.9 7 22l5-3 5 3-1.5-8.1" /></>)}
  {name === 'star' && <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z" />}
  {name === 'arrow' && (<><path d="M7 17 17 7" /><path d="M8 7h9v9" /></>)}
  {name === 'sun' && (<><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>)}
  {name === 'moon' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />}
  {name === 'auto' && (<><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5v17a8.5 8.5 0 0 0 0-17z" fill="currentColor" /></>)}
  {name === 'blueprint' && (<><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9M15 9v12" stroke-dasharray="2 2" /></>)}
</svg>
